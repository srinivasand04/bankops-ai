# ---------------------------------------------------------------
# BankOps AI - environment configuration (copy to .env)
# Never commit .env. All values below are local-development examples.
# ---------------------------------------------------------------

# PostgreSQL (docker-compose service "db")
POSTGRES_USER=bankops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=bankops
# Host port published by docker-compose (5432/5433 are often taken locally)
POSTGRES_HOST_PORT=5445

# Backend
APP_ENV=development
LOG_LEVEL=INFO
# Used when running the backend on the host (outside Docker)
DATABASE_URL=postgresql+psycopg://bankops:change-me-local-only@localhost:5445/bankops
# Used by pytest - a separate database created by docker/postgres/init
TEST_DATABASE_URL=postgresql+psycopg://bankops:change-me-local-only@localhost:5445/bankops_test
CORS_ORIGINS=["http://localhost:5173"]

# Authentication
# false = demo mode: identity comes from X-User-Name / X-User-Role headers (defaults to a demo incident manager)
# true  = every request needs X-API-Key matching an entry in API_KEYS
AUTH_ENABLED=false
# JSON map of api-key -> {"username": ..., "role": ...}; roles: VIEWER, ENGINEER, INCIDENT_MANAGER, ADMIN
API_KEYS={}

# Demonstration SLA targets in minutes (NOT universal banking requirements)
# SLA_TARGETS={"P1":{"response":15,"resolution":60},"P2":{"response":30,"resolution":240},"P3":{"response":240,"resolution":1440},"P4":{"response":480,"resolution":4320}}

# Claude (Phase 5). Leave the key empty to run without AI (AI endpoints return 503).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=high

# AI provider: "anthropic" (Claude API, paid) or "ollama" (local open model, free)
AI_PROVIDER=anthropic
# Ollama (https://ollama.com) - install, then: ollama pull qwen3:8b
# OLLAMA_BASE_URL is used when the backend runs on the host; the Docker backend uses OLLAMA_DOCKER_URL
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=false
OLLAMA_TIMEOUT_SECONDS=900
